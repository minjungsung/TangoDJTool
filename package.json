{
  "name": "tango-dj-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A local-first web workspace for tango DJs.",
  "scripts": {
    "dev": "node --dns-result-order=ipv4first node_modules/vite/bin/vite.js --host localhost",
    "build": "vite build",
    "preview": "node --dns-result-order=ipv4first node_modules/vite/bin/vite.js preview --host localhost",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "test:review": "npm run build && playwright test --config playwright.review.config.js",
    "test:devices": "playwright test --config playwright.devices.config.js",
    "test:install": "npm run build && playwright test --config playwright.install.config.js",
    "android:assetlinks": "node scripts/android-assetlinks.mjs"
  },
  "dependencies": {
    "hash-wasm": "^4.12.0",
    "music-metadata": "^12.2.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0"
  }
}
